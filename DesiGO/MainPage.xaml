<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DesiGO.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <ContentPage.Resources>
        <ResourceDictionary>
            <!--  Marka ve Ana Roller  -->
            <Color x:Key="LabelBgColor">#2B78E4</Color>
            <Color x:Key="EntryPlaceHolderColor">#4A9E92</Color>
            <Color x:Key="GridBgColor">#E0E0E0</Color>
            <Color x:Key="MainBgColor">#2ECC71</Color>
            <Color x:Key="SliderBgColor">#E8F0FE</Color>


            <!--  Durum Renkleri (Feedback / Status)  -->
            <Color x:Key="ButtonBgColor">#F1C40F</Color>
            <Color x:Key="ButtonTextColor">#000000</Color>
            <Color x:Key="DangerColor">#E74C3C</Color>
            <Color x:Key="InfoColor">#3498DB</Color>

            <!--  Nötr Renkler (Metin, Arka Plan, Kenarlık)  -->
            <Color x:Key="BackgroundColor">#F8F9FA</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
            <Color x:Key="TextSecondaryColor">#757575</Color>
        </ResourceDictionary>
    </ContentPage.Resources>



    <ScrollView>
        <VerticalStackLayout Padding="20,20">

            <!--  Gönderici Bilgileri  -->
            <Label
                BackgroundColor="{StaticResource MainBgColor}"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Padding="10"
                Text="Gönderici Bilgileri"
                VerticalTextAlignment="Center" />
            <BoxView HeightRequest="3" />

            <Grid
                BackgroundColor="{StaticResource GridBgColor}"
                ColumnDefinitions="*,2*"
                HeightRequest="250"
                Padding="5"
                RowDefinitions="Auto,Auto,Auto, Auto"
                Width="400">

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="0"
                    Padding="15"
                    Text="Adı Soyadı:"
                    VerticalTextAlignment="Center" />
                <Entry
                    Grid.Column="1"
                    Grid.Row="0"
                    Keyboard="Text"
                    Placeholder="Adınız, Soyadınız"
                    PlaceholderColor="{StaticResource EntryPlaceHolderColor}"
                    VerticalTextAlignment="Center"
                    x:Name="entGndAdSoyad" />

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="1"
                    Padding="15"
                    Text="Adresi:"
                    VerticalTextAlignment="Center" />
                <Entry
                    Grid.Column="1"
                    Grid.Row="1"
                    Keyboard="Text"
                    Placeholder="Adresiniz"
                    PlaceholderColor="{StaticResource EntryPlaceHolderColor}"
                    VerticalTextAlignment="Center"
                    x:Name="entGndAdres" />

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="2"
                    Padding="15"
                    Text="TC Kimlik No:"
                    VerticalTextAlignment="Center" />
                <Entry
                    Grid.Column="1"
                    Grid.Row="2"
                    Keyboard="Text"
                    Placeholder="TC Kimlik No"
                    PlaceholderColor="{StaticResource EntryPlaceHolderColor}"
                    VerticalTextAlignment="Center"
                    x:Name="entGndTCKimlikNo" />


                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="3"
                    Padding="15"
                    Text="Telefon:"
                    VerticalTextAlignment="Center" />
                <Entry
                    Grid.Column="1"
                    Grid.Row="3"
                    Keyboard="Text"
                    Placeholder="Telefon Numarası"
                    PlaceholderColor="{StaticResource EntryPlaceHolderColor}"
                    VerticalTextAlignment="Center"
                    x:Name="entGndTelefon" />

            </Grid>


            <!--  Alıcı Bilgileri  -->
            <Label
                BackgroundColor="{StaticResource MainBgColor}"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Padding="10"
                Text="Alıcı Bilgileri"
                VerticalTextAlignment="Center" />
            <BoxView HeightRequest="3" />

            <Grid
                BackgroundColor="{StaticResource GridBgColor}"
                ColumnDefinitions="*,2*"
                HeightRequest="250"
                Padding="5"
                RowDefinitions="Auto,Auto,Auto, Auto"
                Width="400">

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="0"
                    Padding="15"
                    Text="Adı Soyadı:"
                    VerticalTextAlignment="Center" />
                <Entry
                    Grid.Column="1"
                    Grid.Row="0"
                    Keyboard="Text"
                    Placeholder="Adınız, Soyadınız"
                    PlaceholderColor="{StaticResource EntryPlaceHolderColor}"
                    VerticalTextAlignment="Center"
                    x:Name="entAliciAdSoyad" />

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="1"
                    Padding="15"
                    Text="Adresi:"
                    VerticalTextAlignment="Center" />
                <Entry
                    Grid.Column="1"
                    Grid.Row="1"
                    Keyboard="Text"
                    Placeholder="Adresiniz"
                    PlaceholderColor="{StaticResource EntryPlaceHolderColor}"
                    VerticalTextAlignment="Center"
                    x:Name="entAliciAdres" />

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="2"
                    Padding="15"
                    Text="TC Kimlik No:"
                    VerticalTextAlignment="Center" />
                <Entry
                    Grid.Column="1"
                    Grid.Row="2"
                    Keyboard="Text"
                    Placeholder="TC Kimlik No"
                    PlaceholderColor="{StaticResource EntryPlaceHolderColor}"
                    VerticalTextAlignment="Center"
                    x:Name="entAliciTCKimlikNo" />


                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="3"
                    Padding="15"
                    Text="Telefon:"
                    VerticalTextAlignment="Center" />
                <Entry
                    Grid.Column="1"
                    Grid.Row="3"
                    Keyboard="Text"
                    Placeholder="Telefon Numarası"
                    PlaceholderColor="{StaticResource EntryPlaceHolderColor}"
                    VerticalTextAlignment="Center"
                    x:Name="entAliciTelefon" />

            </Grid>

            <!--  Kargo Bilgileri  -->
            <Label
                BackgroundColor="{StaticResource MainBgColor}"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Padding="10"
                Text="Kargo Bilgileri"
                VerticalTextAlignment="Center" />
            <BoxView HeightRequest="3" />

            <Grid
                BackgroundColor="{StaticResource GridBgColor}"
                ColumnDefinitions="2*,2*,*"
                Padding="5"
                RowDefinitions="Auto,Auto,Auto, Auto, Auto, Auto"
                Width="600">


                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="0"
                    Padding="15"
                    Text="Kargo Eni (cm):"
                    VerticalTextAlignment="Center" />

                <Slider
                    BackgroundColor="{StaticResource SliderBgColor}"
                    Grid.Column="1"
                    Grid.Row="0"
                    Maximum="100"
                    Minimum="0"
                    ValueChanged="SldKargoEni_OnValueChanged"
                    x:Name="sldKargoEni" />
                <Label
                    Grid.Column="2"
                    Grid.Row="0"
                    Padding="5"
                    VerticalTextAlignment="Center"
                    x:Name="lblKargoEni" />


                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="1"
                    Padding="15"
                    Text="Kargo Genişliği (cm):"
                    VerticalTextAlignment="Center" />

                <Slider
                    BackgroundColor="{StaticResource SliderBgColor}"
                    Grid.Column="1"
                    Grid.Row="1"
                    Maximum="100"
                    Minimum="0"
                    ValueChanged="SldKargoGenisligi_OnValueChanged"
                    x:Name="sldKargoGenisligi" />
                <Label
                    Grid.Column="2"
                    Grid.Row="1"
                    Padding="5"
                    VerticalTextAlignment="Center"
                    x:Name="lblKargoGenisligi" />

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="2"
                    Padding="15"
                    Text="Kargo Yüksekliği (cm):"
                    VerticalTextAlignment="Center" />

                <Slider
                    BackgroundColor="{StaticResource SliderBgColor}"
                    Grid.Column="1"
                    Grid.Row="2"
                    Maximum="100"
                    Minimum="0"
                    ValueChanged="SldKargoYuksekligi_OnValueChanged"
                    x:Name="sldKargoYuksekligi" />
                <Label
                    Grid.Column="2"
                    Grid.Row="2"
                    Padding="5"
                    VerticalTextAlignment="Center"
                    x:Name="lblKargoYuksekligi" />

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="3"
                    Padding="15"
                    Text="Kutu Sayısı (adet):"
                    VerticalTextAlignment="Center" />

                <Stepper
                    Grid.Column="1"
                    Grid.Row="3"
                    Margin="20"
                    Maximum="10"
                    Minimum="1"
                    ValueChanged="StpKutuSayisi_OnValueChanged"
                    x:Name="stpKutuSayisi" />
                <Label
                    Grid.Column="2"
                    Grid.Row="3"
                    Padding="5"
                    VerticalTextAlignment="Center"
                    x:Name="lblKutuSayisi" />

                <Label
                    BackgroundColor="{StaticResource LabelBgColor}"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    Grid.Row="4"
                    Padding="15"
                    Text="Kargo Ağırlığı (kg):"
                    VerticalTextAlignment="Center" />

                <Stepper
                    Grid.Column="1"
                    Grid.Row="4"
                    Margin="20"
                    Maximum="100"
                    Minimum="1"
                    ValueChanged="StpKargoAgirligi_OnValueChanged"
                    x:Name="stpKargoAgirligi" />
                <Label
                    Grid.Column="2"
                    Grid.Row="4"
                    Padding="5"
                    VerticalTextAlignment="Center"
                    x:Name="lblKargoAgirligi" />


                <Label
                    BackgroundColor="GreenYellow"
                    FontSize="20"
                    Grid.ColumnSpan="3"
                    Grid.Row="5"
                    HorizontalTextAlignment="Center"
                    Margin="15"
                    Padding="15"
                    Text="Kargo Ücreti:"
                    VerticalTextAlignment="Center"
                    x:Name="lblKargoUcreti" />

            </Grid>




            <VerticalStackLayout HorizontalOptions="Center">

                <Button
                    BackgroundColor="{StaticResource ButtonBgColor}"
                    Clicked="BtnKargoUcretiHesapla_OnClicked"
                    Margin="20"
                    Text="Hesapla"
                    TextColor="{StaticResource ButtonTextColor}"
                    x:Name="btnKargoUcretiHesapla" />

                <Button
                    BackgroundColor="{StaticResource ButtonBgColor}"
                    Clicked="BtnGondericiBilgiGoster_OnClicked"
                    Margin="20"
                    Text="Gönderici Bilgileri"
                    x:Name="btnGondericiBilgiGoster" />

                <Button
                    BackgroundColor="{StaticResource ButtonBgColor}"
                    Clicked="BtnAliciBilgiGoster_OnClicked"
                    Margin="20"
                    Text="Alıcı Bilgileri"
                    x:Name="btnAliciBilgiGoster" />

                <Button
                    BackgroundColor="{StaticResource ButtonBgColor}"
                    Clicked="BtnTumBilgileriGoster_OnClicked"
                    Margin="20"
                    Text="Tüm Bilgileri Göster"
                    x:Name="btnTumBilgileriGoster" />


                <Button
                    BackgroundColor="{StaticResource ButtonBgColor}"
                    Clicked="BtnTumBilgileriTemizle_OnClicked"
                    Margin="20"
                    Text="Tüm Bilgileri Temizle"
                    x:Name="btnTumBilgileriTemizle" />


            </VerticalStackLayout>


        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
